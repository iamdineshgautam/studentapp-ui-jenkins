pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    tools {                 //we are telling we are using which tools here we are using maven
        maven 'maven'
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/iamdineshgautam/studentapp-ui-jenkins.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

